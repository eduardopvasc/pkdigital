# ===================================================================
# NOREN Agency — environment contract
# Copy to `.env.local` for development, and set the same keys in your
# hosting provider (e.g. Vercel Project → Settings → Environment Variables)
# for production. Do NOT commit real values — only this example is tracked.
# ===================================================================

# -------------------------------------------------------------------
# CLIENT PORTAL — AUTH (required in production)
# -------------------------------------------------------------------

# Secret used to sign the portal session cookie (HMAC-SHA256).
# REQUIRED in production. Use a long, random value, e.g.:
#   openssl rand -base64 48
# If unset, a non-secret dev fallback is used (development only) and a
# warning-grade weak secret applies — never rely on it in production.
PORTAL_SESSION_SECRET=

# --- Portal members (choose ONE of the two options below) ----------

# Option A (recommended) — a JSON array of members. Supports multiple
# invite-only clients. Keep this server-side only; it is never exposed
# to the browser.
#   PORTAL_MEMBERS='[{"email":"client@brand.com","password":"strong-pass","name":"Jordan"}]'
PORTAL_MEMBERS=

# Option B — a single member via discrete vars (used only if
# PORTAL_MEMBERS is not set).
PORTAL_EMAIL=
PORTAL_PASSWORD=
PORTAL_NAME=

# -------------------------------------------------------------------
# NOTES
# -------------------------------------------------------------------
# - Passwords are compared in plaintext from env (fine for a small,
#   invite-only client list). Before scale, swap lib/portal-auth.ts to a
#   hashed store / real auth provider — no other portal code changes.
# - With NO portal env set, a development-only fallback member exists:
#       email: client@norenagency.com
#       password: noren-demo
#   This fallback is DISABLED when NODE_ENV=production.
# - The session cookie is httpOnly + SameSite=Lax, and Secure in production.
